# BuyWise Environment Variables Configuration Example
PORT=5000
NODE_ENV=development

# JWT Secret
JWT_SECRET=buywise-secure-student-jwt-secret-key-2025

# MongoDB URI (Optional: Leave blank for zero-setup automatic In-Memory MongoDB Server!)
# MONGODB_URI=mongodb://localhost:27017/buywise
# Or MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/buywise?retryWrites=true&w=majority
MONGODB_URI=

# Python ML Microservice URL (FastAPI)
ML_SERVICE_URL=http://localhost:8000

